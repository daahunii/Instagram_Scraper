# Set these in your runtime environment; .env is not auto-loaded.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repo/service-account.json
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
# Optional for localhost; set behind an authenticated gateway when deployed.
SCRAPER_API_TOKEN=
# Explicit compatibility option. Default: private objects with 15-minute signed URLs.
FIREBASE_PUBLIC_IMAGES=false
